<?xml version="1.0" encoding="utf-8"?>
<!--
    A simple hand-drawn icon of cricket stumps (the three wooden posts + two bails on top) for
    the bottom nav bar's "Matches" tab, since no standard icon library has a ready-made cricket
    icon. It's just three tall thin rectangles (the stumps) with two short rectangles resting on
    top of them (the bails), sitting on a short line (the ground) — drawn on a 24x24 grid, which
    is the standard size Android expects for a bottom-nav icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- left stump -->
    <path android:fillColor="#FF000000" android:pathData="M5,7 L7,7 L7,19 L5,19 Z" />
    <!-- middle stump -->
    <path android:fillColor="#FF000000" android:pathData="M11,7 L13,7 L13,19 L11,19 Z" />
    <!-- right stump -->
    <path android:fillColor="#FF000000" android:pathData="M17,7 L19,7 L19,19 L17,19 Z" />
    <!-- left bail, resting across the left and middle stumps -->
    <path android:fillColor="#FF000000" android:pathData="M6,5.5 L12,5.5 L12,7 L6,7 Z" />
    <!-- right bail, resting across the middle and right stumps -->
    <path android:fillColor="#FF000000" android:pathData="M12,5.5 L18,5.5 L18,7 L12,7 Z" />
    <!-- ground line -->
    <path android:fillColor="#FF000000" android:pathData="M3,19 L21,19 L21,20.5 L3,20.5 Z" />
</vector>
